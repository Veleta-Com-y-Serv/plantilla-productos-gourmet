---
// Galería: titular en una banda oscura y, debajo, un mosaico de fotos de borde a borde sin márgenes (la primera,
// grande). galeria: lista de rutas de fotos. Sin fotos solo se ve el titular (y, sin titular, nada).
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const fotos = s ? s.galeria.slice(0, 24) : [];
---

{
  s && (fotos.length > 0 || s.titulo || s.texto) && (
    <Seccion id={Astro.props.id} banda="oscura" sangre class:list={[fotos.length > 0 && 'pb-0 md:pb-0']}>
      <div class="contenedor">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <Titular class="mb-0 md:mb-0 lg:col-span-7" antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="text-lg text-[color-mix(in_srgb,var(--c-crema)_80%,transparent)] lg:col-span-5 lg:pb-2">{s.texto}</p>}
        </div>
      </div>
      {fotos.length > 0 && (
        <ul class="mosaico mt-12 md:mt-16">
          {fotos.map((f, i) => (
            <li>
              <Imagen src={f} alt={altGaleria(i)} ancho={i === 0 ? 1400 : 800} alto={i === 0 ? 1400 : 800} respaldo="/placeholders/paisaje.svg" />
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
