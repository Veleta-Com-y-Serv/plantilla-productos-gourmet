---
// Contacto: banda oliva a todo el ancho. A la izquierda, titular y datos (teléfono grande en serif, WhatsApp, email,
// dirección con enlace al mapa y horario) en filas con líneas claras; a la derecha, el formulario de pedido sobre la
// propia banda, con el desplegable «Producto» relleno con los nombres de la sección `productos`.
import { seccion, site, tel, mapa, whatsapp, buscarSeccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const productos = (buscarSeccion('productos')?.s.productos ?? []).map((p) => p.nombre).filter(Boolean);
const datos = [
  c.whatsapp && { icono: 'whatsapp', etiqueta: 'WhatsApp', valor: c.whatsapp, url: whatsapp(c.whatsapp) },
  c.email && { icono: 'correo', etiqueta: 'Email', valor: c.email, url: `mailto:${c.email}` },
  c.direccion && { icono: 'mapa', etiqueta: 'Tienda y obrador', valor: c.direccion, url: mapa(c.direccion) },
  c.horario && { icono: 'reloj', etiqueta: 'Horario', valor: c.horario, url: '' },
].filter(Boolean) as { icono: string; etiqueta: string; valor: string; url: string }[];
---

{
  s && (
    <Seccion id={Astro.props.id} banda="oliva">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-5">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {c.telefono && (
            <a href={tel(c.telefono)} class="serif block text-[clamp(2.2rem,5vw,3.4rem)] leading-none text-[var(--c-crema)] no-underline hover:text-[var(--c-acento-claro)]">
              {c.telefono}
            </a>
          )}
          {datos.length > 0 && (
            <dl class="mt-8 border-t border-[var(--c-linea-clara)]">
              {datos.map((d) => (
                <div class="flex gap-4 border-b border-[var(--c-linea-clara)] py-4">
                  <Icono nombre={d.icono} tam={20} class="mt-1 shrink-0 text-[var(--c-acento-claro)]" />
                  <div class="min-w-0">
                    <dt class="versal text-[color-mix(in_srgb,var(--c-crema)_70%,transparent)]">{d.etiqueta}</dt>
                    <dd class="mt-1 break-words">
                      {d.url ? <a href={d.url} class="hover:text-[var(--c-acento-claro)]" rel={/^https?:/.test(d.url) ? 'noopener' : undefined} target={/^https?:/.test(d.url) ? '_blank' : undefined}>{d.valor}</a> : d.valor}
                    </dd>
                  </div>
                </div>
              ))}
            </dl>
          )}
        </div>
        <div class="border-t-4 border-acento pt-8 lg:col-span-7 lg:pt-10">
          <FormularioContacto boton={s.cta?.texto || 'Enviar'} productos={productos} />
        </div>
      </div>
    </Seccion>
  )
}
