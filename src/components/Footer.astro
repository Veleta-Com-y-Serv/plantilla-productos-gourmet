---
// Pie a todo el ancho en oliva casi negro: el nombre del negocio en serif gigante como firma y, debajo, columnas
// de marca y redes, menú (site.yaml → menu), la despensa (categorías de la sección `productos`) y contacto.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, whatsapp, buscarSeccion } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'campo' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const productos = buscarSeccion('productos');
const categorias = productos
  ? ([...new Set(productos.s.productos.map((p) => p.categoria).filter(Boolean))] as string[]).slice(0, 8)
  : [];
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pt-16 md:pt-24">
    <p class="pie-firma" aria-hidden="true">{site.nombre}</p>
  </div>
  <div class="contenedor pie-rejilla mt-12 border-t border-[var(--c-linea-clara)] pt-10 md:mt-16">
    <div class="pie-marca">
      {site.eslogan && <p class="pie-eslogan serif text-xl leading-snug text-[var(--c-crema)]">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      categorias.length > 0 && productos && (
        <div>
          <p class="pie-titulo">{productos.s.antetitulo || productos.s.titulo}</p>
          <ul class="pie-lista">
            {categorias.map((cat) => <li><a href={`/#${productos.id}`}>{cat}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      (c.telefono || c.email || c.direccion || c.horario || c.whatsapp) && (
        <div>
          <p class="pie-titulo">Contacto</p>
          <ul class="pie-lista">
            {c.telefono && <li><a href={tel(c.telefono)} class="serif text-2xl text-[var(--c-crema)]">{c.telefono}</a></li>}
            {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`} class="break-words">{c.email}</a></li>}
            {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            {c.horario && <li class="text-sm opacity-80">{c.horario}</li>}
          </ul>
        </div>
      )
    }
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
