---
// Proceso (del campo a la mesa): banda de papel de estraza con el titular y, debajo, una franja de fotos a sangre
// (de borde a borde, sin márgenes) con el número romano del paso sobre la foto y el título y el texto debajo.
// items: titulo, texto, imagen (opcional; sin foto, un bloque oliva con el número). 1, 2 o hasta 4 columnas.
import { seccion, romano } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((i) => i.titulo) : [];
---

{
  s && (
    <Seccion id={Astro.props.id} banda="kraft" sangre class="pb-0 md:pb-0">
      <div class="contenedor">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <Titular class="mb-0 md:mb-0 lg:col-span-7" antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.texto && <p class="text-lg text-[var(--c-suave)] lg:col-span-5 lg:pb-2">{s.texto}</p>}
        </div>
      </div>
      {items.length > 0 && (
        <ol class="franja-pasos mt-12 md:mt-16" style={`--pasos:${Math.min(items.length, 4)}`}>
          {items.map((it, i) => (
            <li class="flex flex-col border-[var(--c-linea)] sm:border-r">
              <div class="paso-foto">
                {it.imagen && <Imagen src={it.imagen} alt={altFicha(it)} ancho={900} alto={1200} respaldo="/placeholders/paisaje.svg" class="absolute inset-0 h-full w-full object-cover" />}
                <span class="paso-num" aria-hidden="true">{romano(i + 1)}</span>
              </div>
              <div class="px-4 pb-14 pt-6 sm:px-6 lg:px-7">
                <p class="versal text-[var(--c-acento-texto)]">Paso {i + 1}</p>
                <h3 class="mt-2 text-[1.75rem] leading-tight text-primario">{it.titulo}</h3>
                {it.texto && <p class="mt-2 text-[var(--c-suave)]">{it.texto}</p>}
              </div>
            </li>
          ))}
        </ol>
      )}
      {s.cta?.url && <div class="contenedor pb-16"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></div>}
      {!items.length && !s.cta?.url && <div class="h-16" />}
    </Seccion>
  )
}
